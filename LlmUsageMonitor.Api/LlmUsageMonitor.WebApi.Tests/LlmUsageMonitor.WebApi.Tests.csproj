<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <!-- Fixtures/spa stands in for the SPA a release build embeds in the WebApi executable. -->
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Hangfire.InMemory" Version="1.0.0"/>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12"/>
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.12"/>
        <PackageReference Include="Shouldly" Version="4.3.0"/>
        <PackageReference Include="Testcontainers.MongoDb" Version="4.15.0"/>
        <!-- Runs on Microsoft.Testing.Platform (global.json): neither Microsoft.NET.Test.Sdk nor xunit.runner.visualstudio. -->
        <PackageReference Include="xunit.v3" Version="4.0.1"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Fixtures/spa/**" Link="wwwroot$([System.IO.Path]::DirectorySeparatorChar)%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LlmUsageMonitor.WebApi\LlmUsageMonitor.WebApi.csproj"/>
    </ItemGroup>

</Project>
