<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <RootNamespace>LlmUsageMonitor</RootNamespace>
        <!-- The OpenAPI document is written on build next to the front, which generates its client from it. -->
        <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../LlmUsageMonitor.Front/openapi</OpenApiDocumentsDirectory>
        <OpenApiGenerateDocumentsOptions>--file-name llm-usage-monitor</OpenApiGenerateDocumentsOptions>
        <!-- Overridden by the release build (-p:Version from the tag); shown in the SPA through /conf.js. -->
        <Version>0.0.0-dev</Version>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <!-- The default settings, and the SPA of a release build, ship inside the executable (ProductionHosting). -->
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Elyspio.Utils.Telemetry"/>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"/>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded"/>
        <PackageReference Include="OpenTelemetry.Instrumentation.Hangfire"/>
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LlmUsageMonitor.Abstractions\LlmUsageMonitor.Abstractions.csproj"/>
        <ProjectReference Include="..\LlmUsageMonitor.Adapters.Claude\LlmUsageMonitor.Adapters.Claude.csproj"/>
        <ProjectReference Include="..\LlmUsageMonitor.Adapters.Codex\LlmUsageMonitor.Adapters.Codex.csproj"/>
        <ProjectReference Include="..\LlmUsageMonitor.Adapters.Hangfire\LlmUsageMonitor.Adapters.Hangfire.csproj"/>
        <ProjectReference Include="..\LlmUsageMonitor.Adapters.LiteLlm\LlmUsageMonitor.Adapters.LiteLlm.csproj"/>
        <ProjectReference Include="..\LlmUsageMonitor.Adapters.MongoDB\LlmUsageMonitor.Adapters.MongoDB.csproj"/>
        <ProjectReference Include="..\LlmUsageMonitor.Adapters.Ntfy\LlmUsageMonitor.Adapters.Ntfy.csproj"/>
        <ProjectReference Include="..\LlmUsageMonitor.Core\LlmUsageMonitor.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Update="appsettings.Development.json">
            <DependentUpon>appsettings.json</DependentUpon>
        </Content>
        <EmbeddedResource Include="appsettings.json"/>
    </ItemGroup>

    <!-- Release build: the built SPA (-p:SpaRoot=<front dist>) is embedded under wwwroot/, without the development conf.js. -->
    <ItemGroup Condition="'$(SpaRoot)' != ''">
        <EmbeddedResource Include="$(SpaRoot)/**" Exclude="$(SpaRoot)/conf.js" Link="wwwroot$([System.IO.Path]::DirectorySeparatorChar)%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

</Project>
