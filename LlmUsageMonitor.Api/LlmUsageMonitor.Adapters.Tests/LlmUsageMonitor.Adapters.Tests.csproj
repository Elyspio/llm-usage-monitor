<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!-- The cron parser Hangfire embeds (internal there): the tests read the poll schedules with it. -->
        <PackageReference Include="Cronos" Version="0.13.0"/>
        <PackageReference Include="Shouldly" Version="4.3.0"/>
        <PackageReference Include="Testcontainers.MongoDb" Version="4.15.0"/>
        <!-- Runs on Microsoft.Testing.Platform (global.json): neither Microsoft.NET.Test.Sdk nor xunit.runner.visualstudio. -->
        <PackageReference Include="xunit.v3" Version="4.0.1"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LlmUsageMonitor.Adapters.Claude\LlmUsageMonitor.Adapters.Claude.csproj"/>
        <ProjectReference Include="..\LlmUsageMonitor.Adapters.Codex\LlmUsageMonitor.Adapters.Codex.csproj"/>
        <ProjectReference Include="..\LlmUsageMonitor.Adapters.Hangfire\LlmUsageMonitor.Adapters.Hangfire.csproj"/>
        <ProjectReference Include="..\LlmUsageMonitor.Adapters.LiteLlm\LlmUsageMonitor.Adapters.LiteLlm.csproj"/>
        <ProjectReference Include="..\LlmUsageMonitor.Adapters.MongoDB\LlmUsageMonitor.Adapters.MongoDB.csproj"/>
        <ProjectReference Include="..\LlmUsageMonitor.Adapters.Ntfy\LlmUsageMonitor.Adapters.Ntfy.csproj"/>
        <!-- Built first, then copied into fake-cli-bin/ by CopyFakeCli (on Linux, the SDK copies the fake-cli apphost itself next to the tests): the CLI adapters run it in place of claude and codex. -->
        <ProjectReference Include="..\LlmUsageMonitor.FakeCli\LlmUsageMonitor.FakeCli.csproj" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Raw provider responses captured once, anonymized (no token, account id nor email). -->
        <None Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <Target Name="CopyFakeCli" AfterTargets="Build">
        <MSBuild Projects="..\LlmUsageMonitor.FakeCli\LlmUsageMonitor.FakeCli.csproj" Targets="GetTargetPath">
            <Output TaskParameter="TargetOutputs" PropertyName="FakeCliTargetPath"/>
        </MSBuild>
        <ItemGroup>
            <FakeCliFiles Include="$([System.IO.Path]::GetDirectoryName($(FakeCliTargetPath)))\fake-cli*"/>
        </ItemGroup>
        <Copy SourceFiles="@(FakeCliFiles)" DestinationFolder="$(OutDir)fake-cli-bin" SkipUnchangedFiles="true"/>
    </Target>

</Project>
