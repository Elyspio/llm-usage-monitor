{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["ESNext"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"strict": true,
		"noImplicitAny": true,
		"noFallthroughCasesInSwitch": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src", "vite.config.ts"]
}
