{
	"name": "@elyspio/llm-usage-collector",
	"version": "0.1.0",
	"description": "Uploads the hourly Claude Code and Codex token usage of a workstation to LLM Usage Monitor.",
	"license": "MIT",
	"author": "jona.guich69@gmail.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/Elyspio/llm-usage-monitor.git",
		"directory": "LlmUsageMonitor.Collector"
	},
	"bin": {
		"llm-usage": "./dist/cli.mjs"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "vp pack -F lib",
		"build:exe": "vp pack -F exe",
		"check": "vp check",
		"test": "vp test run",
		"release": "pwsh ./release.ps1"
	},
	"devDependencies": {
		"@elyspio/vite-eslint-config": "8.0.0-rc.0",
		"@types/node": "^26.5.1",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.5.1"
}
