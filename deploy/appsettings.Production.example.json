{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning",
			"Hangfire": "Warning"
		}
	},
	"ConnectionStrings": {
		"MongoDB": "mongodb://llm-usage-monitor:CHANGE_ME@db-node-01.elylan:27017,db-node-02.elylan:27017,db-node-03.elylan:27017/llm-usage-monitor?replicaSet=rs-shard-a&authSource=llm-usage-monitor"
	},
	"Oidc": {
		"Authority": "https://auth.elyspio.fr/realms/internal",
		"ClientId": "i-llm-usage-monitor"
	},
	"App": {
		"PublicUrl": "https://monitor.llm.elyspio.fr",
		"AutoTriggerEnabledByDefault": true
	},
	"ForwardedHeaders": {
		"KnownProxies": ["CHANGE_ME (IP of proxy.elylan as seen from the LXC)"]
	},
	"OpenTelemetry": {
		"CollectorUri": "https://collector.telemetry.elylan/",
		"Service": "llm-usage-monitor",
		"Protocol": "HttpProtobuf"
	},
	"Claude": {
		"Executable": "/var/lib/llm-monitor/.local/bin/claude"
	},
	"Codex": {
		"Executable": "/var/lib/llm-monitor/.local/bin/codex"
	}
}
