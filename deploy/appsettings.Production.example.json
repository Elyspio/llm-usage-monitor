{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning",
			"Hangfire": "Warning"
		}
	},
	"ConnectionStrings": {
		"MongoDB": "connection_string_to_mongodb"
	},
	"Oidc": {
		"Authority": "keycloak_realm_full_url",
		"ClientId": "client_id",
		"AuthorizedParties": ["i-llm-usage-collector", "i-elytools"]
	},
	"App": {
		"PublicUrl": "app_public_url",
		"AutoTriggerEnabledByDefault": true
	},
	"ForwardedHeaders": {
		"KnownProxies": ["proxy_ip"]
	},
	"OpenTelemetry": {
		"CollectorUri": "https://collector.telemetry.elylan/",
		"Service": "llm-usage-monitor",
		"Protocol": "HttpProtobuf"
	},
	"Claude": {
		"Executable": "/var/lib/llm-monitor/.local/bin/claude"
	},
	"Codex": {
		"Executable": "/var/lib/llm-monitor/.local/bin/codex"
	}
}
